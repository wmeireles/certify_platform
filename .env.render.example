# Render: Static Site > Environment > Add from .env.
# Public value embedded at build time. Rebuild after changing it.
VITE_API_URL=https://SUA-API.onrender.com/api/v1
# This service uses Node 24, matching package.json and .node-version.
NODE_VERSION=24
SKIP_INSTALL_DEPS=true
# Never add SECRET_KEY, ACCESS_KEY, MongoDB or SMTP credentials to VITE_*.
